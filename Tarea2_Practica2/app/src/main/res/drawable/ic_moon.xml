<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Luna creciente: círculo grande (r=9, cx=12, cy=12)
         menos un círculo pequeño (r=7, cx=17, cy=12).
         El fillType=evenOdd crea el recorte correcto (crescent). -->
    <path
        android:fillType="evenOdd"
        android:fillColor="@android:color/white"
        android:pathData="
            M12,12
            m-9,0
            a9,9 0 1,0 18,0
            a9,9 0 1,0 -18,0

            M17,12
            m-7,0
            a7,7 0 1,1 14,0
            a7,7 0 1,1 -14,0
        " />
</vector>
